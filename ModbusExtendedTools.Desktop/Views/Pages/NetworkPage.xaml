<Page
    x:Class="ModbusExtendedTools.Desktop.Views.Pages.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Сеть"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    FontFamily="Consolas"
    Foreground="{DynamicResource PrimaryTextBrush}"
    mc:Ignorable="d">
    <Grid Margin="28,24" ColumnDefinitions="320,24,*">

        <!--  ЛЕВАЯ КОЛОНКА: устройства и поиск  -->
        <Grid Grid.Column="0" RowDefinitions="Auto,16,*">
            <StackPanel Grid.Row="0">
                <TextBlock
                    FontSize="26"
                    FontWeight="SemiBold"
                    Text="Сеть" />
                <TextBlock
                    Margin="0,6,0,0"
                    Foreground="{DynamicResource SecondaryTextBrush}"
                    Text="Поиск и подключение устройств"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="2" Style="{DynamicResource SectionBorderStyle}">
                <Grid RowDefinitions="Auto,Auto,16,Auto,12,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="Найденные устройства" />
                        <Border
                            Grid.Column="1"
                            Padding="8,3"
                            Background="{DynamicResource SurfaceHoverBrush}"
                            CornerRadius="10">
                            <TextBlock FontSize="12" Text="{Binding ModbusDevices.Count}" />
                        </Border>
                    </Grid>
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,6,0,0"
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="Устройства появятся здесь после поиска в текущей подсети."
                        TextWrapping="Wrap" />

                    <ui:Button
                        Grid.Row="3"
                        Appearance="Secondary"
                        Command="{Binding ScanDevicesAsyncCommand}"
                        Content="Найти устройства" />

                    <Border
                        Grid.Row="5"
                        Background="{DynamicResource ApplicationBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Grid>
                            <ui:ListView
                                x:Name="ModbusDeviceList"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                ItemsSource="{Binding ModbusDevices}">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <EventSetter Event="MouseDoubleClick" Handler="Device_DoubleClick" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding IpAddress}">
                                            <GridViewColumn.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        FontSize="15"
                                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                                        Text="IP Адрес" />
                                                    <ui:SymbolIcon
                                                        Margin="4,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                                        Symbol="DeviceEq24" />
                                                </StackPanel>
                                            </GridViewColumn.Header>
                                        </GridViewColumn>
                                        <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding PortNumber}">
                                            <GridViewColumn.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        FontSize="15"
                                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                                        Text="Порт" />
                                                    <ui:SymbolIcon
                                                        Margin="4,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                                        Symbol="SerialPort24" />
                                                </StackPanel>
                                            </GridViewColumn.Header>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ui:ListView>
                            <StackPanel
                                Margin="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <ui:SymbolIcon
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    Symbol="PlugDisconnected24" />
                                <TextBlock
                                    Margin="0,12,0,0"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    Text="Устройства пока не найдены"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!--  ПРАВАЯ КОЛОНКА: настройка адаптера ПК и подключения  -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="660">
                <TextBlock
                    FontSize="26"
                    FontWeight="SemiBold"
                    Text="Настройки сети" />
                <TextBlock
                    Margin="0,6,0,16"
                    Foreground="{DynamicResource SecondaryTextBrush}"
                    Text="Укажите сетевой адаптер ПК, его IP-адрес и маску, а также параметры подключения к устройствам."
                    TextWrapping="Wrap" />

                <!--  Секция: Сетевой адаптер ПК  -->
                <Border Style="{DynamicResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock
                            FontSize="17"
                            FontWeight="SemiBold"
                            Text="Сетевой адаптер ПК" />

                        <TextBlock
                            Margin="0,16,0,6"
                            Style="{DynamicResource FieldLabelStyle}"
                            Text="Доступные адаптеры" />

                        <ComboBox
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding NetworkInterfaces}"
                            SelectedItem="{Binding SelectedNetworkInterface}" />

                        <Grid Margin="0,14,0,0" ColumnDefinitions="*,16,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{DynamicResource FieldLabelStyle}" Text="IP-адрес ПК" />
                                <ui:TextBox
                                    Background="{DynamicResource ApplicationBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    PlaceholderText="192.168.1.100"
                                    Text="{Binding IpAddress}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{DynamicResource FieldLabelStyle}" Text="Маска подсети" />
                                <ui:TextBox
                                    Background="{DynamicResource ApplicationBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    PlaceholderText="255.255.255.0"
                                    Text="{Binding SubnetMask}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="15"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            TextWrapping="Wrap">
                            <Run
                                FontSize="15"
                                FontWeight="Bold"
                                Text="Параметр IP-" />
                            <Run
                                FontSize="15"
                                FontWeight="Bold"
                                Text="{Binding IpParameter}" />
                        </TextBlock>

                        <StackPanel
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"
                            Orientation="Horizontal">
                            <ui:Button
                                Margin="0,0,10,0"
                                Appearance="Secondary"
                                Command="{Binding SetIpDynamicCommand}"
                                Content="Установить DHCP" />
                            <ui:Button
                                Appearance="Secondary"
                                Command="{Binding SetIpAddressCommand}"
                                Content="Применить настройки адаптера" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  Секция: Параметры подключения к устройствам  -->
                <Border Margin="0,16,0,0" Style="{DynamicResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock
                            FontSize="17"
                            FontWeight="SemiBold"
                            Text="Параметры подключения к устройствам" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            Text="Общие параметры Modbus TCP для подключения к ПЛК, модулям и другим слейв-устройствам."
                            TextWrapping="Wrap" />

                        <Grid Margin="0,16,0,0" ColumnDefinitions="*,16,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{DynamicResource FieldLabelStyle}" Text="Порт устройства" />
                                <ui:TextBox
                                    Background="{DynamicResource ApplicationBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    PlaceholderText="502" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{DynamicResource FieldLabelStyle}" Text="Таймаут, мс" />
                                <ui:TextBox
                                    Background="{DynamicResource ApplicationBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    PlaceholderText="1000" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,14,0,0" ColumnDefinitions="*,16,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{DynamicResource FieldLabelStyle}" Text="Количество попыток" />
                                <ui:TextBox
                                    Background="{DynamicResource ApplicationBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    PlaceholderText="3" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{DynamicResource FieldLabelStyle}" Text="Задержка между попытками, мс" />
                                <ui:TextBox
                                    Background="{DynamicResource ApplicationBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    PlaceholderText="200" />
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Margin="0,8,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            Text="Стандартный порт Modbus TCP — 502. При необходимости его можно изменить."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  Секция: Диапазон поиска  -->
                <Border Margin="0,16,0,0" Style="{DynamicResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock
                            FontSize="17"
                            FontWeight="SemiBold"
                            Text="Диапазон поиска устройств" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            Text="Ограничьте диапазон адресов, чтобы ускорить сканирование подсети."
                            TextWrapping="Wrap" />

                        <Grid Margin="0,16,0,0" ColumnDefinitions="*,16,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{DynamicResource FieldLabelStyle}" Text="Начальный адрес" />
                                <ui:TextBox
                                    Background="{DynamicResource ApplicationBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    PlaceholderText="192.168.1.1"
                                    Text="{Binding StartIpAddress}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{DynamicResource FieldLabelStyle}" Text="Конечный адрес" />
                                <ui:TextBox
                                    Background="{DynamicResource ApplicationBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    PlaceholderText="192.168.1.254"
                                    Text="{Binding EndIpAddress}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
