<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ApplicationBackgroundColor">#FFF3F4F7</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="SurfaceHoverColor">#FFE9EBF2</Color>
    <Color x:Key="BorderColor">#FFD8DBE3</Color>
    <Color x:Key="PrimaryTextColor">#FF25272D</Color>
    <Color x:Key="SecondaryTextColor">#FF686D78</Color>
    <Color x:Key="AccentColor">#FF4B57C5</Color>
    <Color x:Key="AccentHoverColor">#FF3E49AD</Color>
    <Color x:Key="OnAccentColor">#FFFFFFFF</Color>
    <Color x:Key="ErrorColor">#FFBF3F52</Color>
    <Color x:Key="DisabledForegroundColor">#FF9A9DA6</Color>
    <Color x:Key="SelectedRowBackgroundColor">#FFE5E8F8</Color>

    <SolidColorBrush x:Key="ButtonBackground" Color="{DynamicResource SurfaceColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{DynamicResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{DynamicResource SelectedRowBackgroundColor}" />
    <SolidColorBrush x:Key="ButtonForeground" Color="{DynamicResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{DynamicResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#FFE5E7EC" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{DynamicResource DisabledForegroundColor}" />


    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{DynamicResource ApplicationBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{DynamicResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{DynamicResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{DynamicResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{DynamicResource OnAccentColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource ErrorColor}" />
    <SolidColorBrush x:Key="SecondaryColor" Color="{DynamicResource ApplicationBackgroundColor}" />
    <SolidColorBrush x:Key="PrimaryForeground" Color="{DynamicResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="DisabledForeground" Color="{DynamicResource DisabledForegroundColor}" />
    <SolidColorBrush x:Key="RowHoverColor" Color="{DynamicResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SelectedRowBackground" Color="{DynamicResource SelectedRowBackgroundColor}" />
    <SolidColorBrush x:Key="SelectedRowForeground" Color="{DynamicResource PrimaryTextColor}" />
</ResourceDictionary>