<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ApplicationBackgroundColor">#FF1E1F22</Color>
    <Color x:Key="SurfaceColor">#FF2B2D31</Color>
    <Color x:Key="SurfaceHoverColor">#FF393C43</Color>
    <Color x:Key="BorderColor">#FF454850</Color>
    <Color x:Key="PrimaryTextColor">#FFE2E3E7</Color>
    <Color x:Key="SecondaryTextColor">#FFA4A7B0</Color>
    <Color x:Key="AccentColor">#FF7884E8</Color>
    <Color x:Key="AccentHoverColor">#FF8F9AF2</Color>
    <Color x:Key="OnAccentColor">#FF171925</Color>
    <Color x:Key="ErrorColor">#FFF07883</Color>
    <Color x:Key="DisabledForegroundColor">#FF777A84</Color>
    <Color x:Key="SelectedRowBackgroundColor">#FF383D5A</Color>

    <SolidColorBrush Color="{DynamicResource SurfaceColor}" x:Key="ButtonBackground" />
    <SolidColorBrush Color="{DynamicResource SurfaceHoverColor}" x:Key="ButtonBackgroundPointerOver" />
    <SolidColorBrush Color="{DynamicResource SelectedRowBackgroundColor}" x:Key="ButtonBackgroundPressed" />
    <SolidColorBrush Color="{DynamicResource PrimaryTextColor}" x:Key="ButtonForeground" />
    <SolidColorBrush Color="{DynamicResource PrimaryTextColor}" x:Key="ButtonForegroundPressed" />
    <SolidColorBrush Color="#FF35373C" x:Key="ButtonBackgroundDisabled" />
    <SolidColorBrush Color="{DynamicResource DisabledForegroundColor}" x:Key="ButtonForegroundDisabled" />

    <SolidColorBrush Color="{DynamicResource ApplicationBackgroundColor}" x:Key="ApplicationBackgroundBrush" />
    <SolidColorBrush Color="{DynamicResource SurfaceColor}" x:Key="SurfaceBrush" />
    <SolidColorBrush Color="{DynamicResource SurfaceHoverColor}" x:Key="SurfaceHoverBrush" />
    <SolidColorBrush Color="{DynamicResource BorderColor}" x:Key="BorderBrush" />
    <SolidColorBrush Color="{DynamicResource PrimaryTextColor}" x:Key="PrimaryTextBrush" />
    <SolidColorBrush Color="{DynamicResource SecondaryTextColor}" x:Key="SecondaryTextBrush" />
    <SolidColorBrush Color="{DynamicResource AccentColor}" x:Key="AccentBrush" />
    <SolidColorBrush Color="{DynamicResource AccentHoverColor}" x:Key="AccentHoverBrush" />
    <SolidColorBrush Color="{DynamicResource OnAccentColor}" x:Key="OnAccentBrush" />
    <SolidColorBrush Color="{DynamicResource ErrorColor}" x:Key="ErrorBrush" />
    <SolidColorBrush Color="{DynamicResource ApplicationBackgroundColor}" x:Key="SecondaryColor" />
    <SolidColorBrush Color="{DynamicResource PrimaryTextColor}" x:Key="PrimaryForeground" />
    <SolidColorBrush Color="{DynamicResource DisabledForegroundColor}" x:Key="DisabledForeground" />
    <SolidColorBrush Color="{DynamicResource SurfaceHoverColor}" x:Key="RowHoverColor" />
    <SolidColorBrush Color="{DynamicResource SelectedRowBackgroundColor}" x:Key="SelectedRowBackground" />
    <SolidColorBrush Color="{DynamicResource PrimaryTextColor}" x:Key="SelectedRowForeground" />
</ResourceDictionary>
